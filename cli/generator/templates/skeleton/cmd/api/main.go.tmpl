package main

import (
	"context"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/gofiber/fiber/v2"
[[- if .Redis ]]
	"github.com/redis/go-redis/v9"
[[- end ]]
	"github.com/rs/zerolog/log"

	"[[.Module]]/config"
	"[[.Module]]/internal/delivery/http/handler"
	mw "[[.Module]]/internal/delivery/http/middleware"
	"[[.Module]]/internal/delivery/http/route"
	"[[.Module]]/internal/domain/entity"
	domainrepo "[[.Module]]/internal/domain/repository"
	dbrepo "[[.Module]]/internal/repository/db"
	memoryrepo "[[.Module]]/internal/repository/memory"
[[- if .Redis ]]
	redisrepo "[[.Module]]/internal/repository/redis"
[[- end ]]
	"[[.Module]]/internal/usecase"
	"[[.Module]]/pkg/database"
	applogger "[[.Module]]/pkg/logger"
[[- if .Kafka ]]
	kafkamsg "[[.Module]]/pkg/messaging/kafka"
[[- end ]]
[[- if .RabbitMQ ]]
	rabbitmqmsg "[[.Module]]/pkg/messaging/rabbitmq"
[[- end ]]
	"[[.Module]]/pkg/observability"
	"[[.Module]]/pkg/ratelimit"
	"[[.Module]]/pkg/validator"
)

const version = "0.1.0"

func main() {
	cfg, err := config.Load()
	if err != nil {
		log.Fatal().Err(err).Msg("failed to load config")
	}

	applogger.Setup(cfg.App.Env, cfg.Log.Level, cfg.Log.FilePath, cfg.Log.ToFile, cfg.App.Name)

	// Structured sinks → logs/{api,consumer,thirdparty,trace}.log
	if err := applogger.SetupSinks(applogger.SinkConfig{
		Dir:        cfg.Log.Dir,
		Rotation:   cfg.Log.Rotation,
		MaxAgeDays: cfg.Log.MaxAgeDays,
		Console:    cfg.App.Env != "production",
	}); err != nil {
		log.Fatal().Err(err).Msg("failed to setup log sinks")
	}

	log.Info().Str("version", version).Str("env", cfg.App.Env).
		Str("observability", cfg.Observability.Provider).Msg("starting service")

	// Observability provider: "otel", "elastic_apm", or "none"
	obsProvider, err := observability.New(context.Background(), &cfg.Observability, cfg.App.Name, version, cfg.App.Env)
	if err != nil {
		log.Fatal().Err(err).Msg("failed to setup observability provider")
	}

	db, err := database.NewConnection(&cfg.DB)
	if err != nil {
		log.Fatal().Err(err).Msg("failed to connect to database")
	}
	if err := obsProvider.InstrumentGORM(db); err != nil {
		log.Warn().Err(err).Msg("gorm instrumentation failed")
	}
	sqlDB, err := db.DB()
	if err != nil {
		log.Fatal().Err(err).Msg("failed to get underlying sql.DB")
	}

	if cfg.DB.AutoMigrate {
		if cfg.App.Env == "production" {
			log.Fatal().Msg("DB_AUTO_MIGRATE is not allowed in production; run ./cmd/migrate instead")
		}
		log.Warn().Msg("DB_AUTO_MIGRATE is enabled: development only, use ./cmd/migrate for real schema changes")
		if err := db.AutoMigrate(&entity.User{}); err != nil {
			log.Fatal().Err(err).Msg("auto-migrate failed")
		}
	}
	// Redis is optional: without REDIS_URL the cache is an in-process fallback.
[[- if .Redis ]]
	var redisClient *redis.Client
	var cacher domainrepo.Cacher
	redisEnabled := cfg.Redis.Enabled()
	if redisEnabled {
		redisClient = newRedisClient(&cfg.Redis)
		obsProvider.InstrumentRedis(redisClient)
		cacher = redisrepo.New(redisClient, "app")
	} else {
		cacher = memoryrepo.New("app")
		log.Warn().Msg("REDIS_URL is empty: cache is in-process, instance-local and lost on restart")
	}
[[- else ]]
	var cacher domainrepo.Cacher = memoryrepo.New("app")
[[- end ]]

	userRepo := dbrepo.NewUserRepository(db)
	userUC := usecase.NewUserUseCase(userRepo, cacher)
	val := validator.New()

	startTime := time.Now()
	userHandler := handler.NewUserHandler(userUC, val)
	healthHandler := handler.NewHealthHandler(sqlDB, startTime, version)
[[- if .Redis ]]

	if redisEnabled {
		healthHandler.AddChecker("redis", func(ctx context.Context) string {
			pingCtx, cancel := context.WithTimeout(ctx, 2*time.Second)
			defer cancel()
			if err := redisClient.Ping(pingCtx).Err(); err != nil {
				return "down"
			}
			return "ok"
		})
	}
[[- end ]]
[[- if .Kafka ]]

	if cfg.Kafka.Brokers != "" {
		healthHandler.AddChecker("kafka", kafkamsg.HealthCheck(cfg.Kafka.Brokers))
	} else {
		healthHandler.AddChecker("kafka", func(_ context.Context) string { return "not_configured" })
	}
[[- end ]]
[[- if .RabbitMQ ]]

	if cfg.RabbitMQ.DSN != "" {
		healthHandler.AddChecker("rabbitmq", rabbitmqmsg.HealthCheck(cfg.RabbitMQ.DSN))
	} else {
		healthHandler.AddChecker("rabbitmq", func(_ context.Context) string { return "not_configured" })
	}
[[- end ]]

	// Rate limiter: shared via Redis when configured, otherwise per-instance.
	rlWindow, err := time.ParseDuration(cfg.RateLimit.Window)
	if err != nil || rlWindow <= 0 {
		rlWindow = time.Minute
	}
	var globalLimiter ratelimit.Limiter
[[- if .Redis ]]
	if cfg.RateLimit.Backend == "redis" && redisEnabled {
		globalLimiter = ratelimit.NewRedis(redisClient, cfg.RateLimit.Prefix, cfg.RateLimit.Max, rlWindow)
		log.Info().Str("backend", "redis").Msg("shared rate limiting enabled")
	} else if cfg.RateLimit.Backend == "redis" {
		log.Warn().Msg("RATE_LIMIT_BACKEND=redis requires REDIS_URL; falling back to per-instance limiting")
	}
[[- else ]]
	if cfg.RateLimit.Backend == "redis" {
		log.Warn().Msg("RATE_LIMIT_BACKEND=redis requires the redis add-on; falling back to per-instance limiting")
	}
[[- end ]]
	if globalLimiter == nil {
		globalLimiter = ratelimit.NewMemory(cfg.RateLimit.Max, rlWindow)
		log.Info().Str("backend", "memory").Msg("rate limiting is per-instance (not shared across replicas)")
	}

	app := fiber.New(fiber.Config{
		AppName:               cfg.App.Name,
		BodyLimit:             4 * 1024 * 1024,
		ReadTimeout:           10 * time.Second,
		WriteTimeout:          10 * time.Second,
		IdleTimeout:           120 * time.Second,
		DisableStartupMessage: true,
		ErrorHandler: func(c *fiber.Ctx, err error) error {
			code := fiber.StatusInternalServerError
			if e, ok := err.(*fiber.Error); ok {
				code = e.Code
			}
			return c.Status(code).JSON(fiber.Map{
				"status":  false,
				"message": http.StatusText(code),
			})
		},
	})

	app.Use(mw.Recover())
	app.Use(mw.RequestID())
	app.Use(mw.SecurityHeaders())
	app.Use(mw.RateLimiterWith(globalLimiter))
	app.Use(mw.RequestLogger())
	app.Use(mw.CORS(cfg.App.CORSAllowedOrigins))
	app.Use(obsProvider.HTTPMiddleware())
	app.Use(observability.MetricsMiddleware())
	// Full request/response journal → api.log (after obs so trace_id is available).
	app.Use(mw.AccessLog(mw.AccessLogOptions{
		BodyMaxBytes:  cfg.Log.BodyMaxBytes,
		CaptureBodies: cfg.Log.HTTPBodies,
	}))

	route.Setup(app, userHandler, healthHandler, cfg.App.Env)

	go func() {
		addr := ":" + cfg.App.Port
		log.Info().Str("addr", addr).Msg("http server listening")
		if err := app.Listen(addr); err != nil {
			log.Fatal().Err(err).Msg("http server error")
		}
	}()

	quit := make(chan os.Signal, 1)
	signal.Notify(quit, os.Interrupt, syscall.SIGTERM)
	<-quit

	log.Info().Msg("shutdown signal received")

	shutCtx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()

	if err := app.ShutdownWithContext(shutCtx); err != nil {
		log.Error().Err(err).Msg("http server forced shutdown")
	}

	if err := obsProvider.Shutdown(shutCtx); err != nil {
		log.Error().Err(err).Msg("observability provider shutdown error")
	}
[[- if .Redis ]]

	if redisClient != nil {
		redisClient.Close() //nolint:errcheck
	}
[[- end ]]
	sqlDB.Close() //nolint:errcheck

	log.Info().Msg("shutdown complete")
}
[[- if .Redis ]]

func newRedisClient(cfg *config.RedisConfig) *redis.Client {
	opts, err := redis.ParseURL(cfg.URL)
	if err != nil {
		opts = &redis.Options{Addr: "localhost:6379"}
	}
	if cfg.Password != "" {
		opts.Password = cfg.Password
	}
	if cfg.DB > 0 {
		opts.DB = cfg.DB
	}
	if cfg.PoolSize > 0 {
		opts.PoolSize = cfg.PoolSize
	}
	if cfg.MinIdleConns > 0 {
		opts.MinIdleConns = cfg.MinIdleConns
	}
	if cfg.MaxRetries > 0 {
		opts.MaxRetries = cfg.MaxRetries
	}
	if d, err := time.ParseDuration(cfg.DialTimeout); err == nil {
		opts.DialTimeout = d
	}
	if d, err := time.ParseDuration(cfg.ReadTimeout); err == nil {
		opts.ReadTimeout = d
	}
	if d, err := time.ParseDuration(cfg.WriteTimeout); err == nil {
		opts.WriteTimeout = d
	}
	return redis.NewClient(opts)
}
[[- end ]]
