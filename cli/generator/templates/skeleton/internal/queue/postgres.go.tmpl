// Package queue implements a small Postgres-backed job queue.
//
// Jobs are claimed with SELECT ... FOR UPDATE SKIP LOCKED, so any number of
// worker processes can drain the same table without running a job twice.
// No broker is required: the database is the queue.
package queue

import (
	"context"
	"database/sql"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"sync"
	"time"

	"github.com/rs/zerolog/log"
)

// Job statuses stored in jobs.status (see migrations/000002_jobs.up.sql).
const (
	StatusPending = "pending"
	StatusRunning = "running"
	StatusDone    = "done"
	StatusFailed  = "failed"
)

// Job is one claimed unit of work.
type Job struct {
	ID          int64
	Kind        string
	Payload     []byte
	Attempts    int
	MaxAttempts int
}

// Handler processes a job. Returning an error schedules a retry (with backoff)
// until MaxAttempts is reached, at which point the job is marked failed.
type Handler func(ctx context.Context, job *Job) error

// Options tunes the queue. Zero values fall back to safe defaults.
type Options struct {
	PollInterval      time.Duration // how long to sleep when the queue is empty (default 2s)
	RetryBase         time.Duration // first retry delay, doubled per attempt (default 5s)
	RetryMax          time.Duration // retry delay cap (default 10m)
	VisibilityTimeout time.Duration // a running job older than this is requeued (default 5m)
	MaxAttempts       int           // default max attempts for new jobs (default 5)
	LockID            string        // worker identity recorded in jobs.locked_by
}

// PostgresQueue is a job queue backed by a Postgres table.
type PostgresQueue struct {
	db   *sql.DB
	opts Options
}

// NewPostgresQueue creates the queue and applies option defaults.
func NewPostgresQueue(db *sql.DB, opts Options) *PostgresQueue {
	if opts.PollInterval <= 0 {
		opts.PollInterval = 2 * time.Second
	}
	if opts.RetryBase <= 0 {
		opts.RetryBase = 5 * time.Second
	}
	if opts.RetryMax <= 0 {
		opts.RetryMax = 10 * time.Minute
	}
	if opts.VisibilityTimeout <= 0 {
		opts.VisibilityTimeout = 5 * time.Minute
	}
	if opts.MaxAttempts <= 0 {
		opts.MaxAttempts = 5
	}
	if opts.LockID == "" {
		host, _ := os.Hostname()
		opts.LockID = fmt.Sprintf("%s-%d", host, os.Getpid())
	}
	return &PostgresQueue{db: db, opts: opts}
}

// Enqueue inserts a pending job. A zero runAt means "run now".
func (q *PostgresQueue) Enqueue(ctx context.Context, kind string, payload any, runAt time.Time) (int64, error) {
	raw := []byte("{}")
	if payload != nil {
		b, err := json.Marshal(payload)
		if err != nil {
			return 0, fmt.Errorf("enqueue marshal payload: %w", err)
		}
		raw = b
	}
	if runAt.IsZero() {
		runAt = time.Now()
	}

	var id int64
	err := q.db.QueryRowContext(ctx, `
		INSERT INTO jobs (kind, payload, run_at, max_attempts)
		VALUES ($1, $2, $3, $4)
		RETURNING id`, kind, raw, runAt, q.opts.MaxAttempts).Scan(&id)
	if err != nil {
		return 0, fmt.Errorf("enqueue job: %w", err)
	}
	return id, nil
}

const claimSQL = `
WITH candidate AS (
    SELECT id FROM jobs
    WHERE status = 'pending' AND run_at <= now()
    ORDER BY run_at
    FOR UPDATE SKIP LOCKED
    LIMIT 1
)
UPDATE jobs j
SET status     = 'running',
    attempts   = j.attempts + 1,
    locked_at  = now(),
    locked_by  = $1,
    updated_at = now()
FROM candidate c
WHERE j.id = c.id
RETURNING j.id, j.kind, j.payload, j.attempts, j.max_attempts`

// Claim atomically locks and returns the next due job, or (nil, nil) when the
// queue is empty. SKIP LOCKED means concurrent workers never get the same row.
func (q *PostgresQueue) Claim(ctx context.Context, lockID string) (*Job, error) {
	job := &Job{}
	err := q.db.QueryRowContext(ctx, claimSQL, lockID).Scan(
		&job.ID, &job.Kind, &job.Payload, &job.Attempts, &job.MaxAttempts,
	)
	if errors.Is(err, sql.ErrNoRows) {
		return nil, nil
	}
	if err != nil {
		return nil, fmt.Errorf("claim job: %w", err)
	}
	return job, nil
}

// Complete marks a job as done.
func (q *PostgresQueue) Complete(ctx context.Context, id int64) error {
	_, err := q.db.ExecContext(ctx, `
		UPDATE jobs
		SET status = 'done', locked_at = NULL, locked_by = NULL, last_error = NULL, updated_at = now()
		WHERE id = $1`, id)
	if err != nil {
		return fmt.Errorf("complete job %d: %w", id, err)
	}
	return nil
}

// Retry schedules another attempt with exponential backoff, or marks the job
// failed when it has exhausted its attempts.
func (q *PostgresQueue) Retry(ctx context.Context, job *Job, cause error) error {
	if job.Attempts >= job.MaxAttempts {
		return q.FailPermanent(ctx, job, cause)
	}
	delay := q.retryDelay(job.Attempts)
	_, err := q.db.ExecContext(ctx, `
		UPDATE jobs
		SET status = 'pending', run_at = now() + make_interval(secs => $2),
		    locked_at = NULL, locked_by = NULL, last_error = $3, updated_at = now()
		WHERE id = $1`, job.ID, delay.Seconds(), truncateError(cause))
	if err != nil {
		return fmt.Errorf("retry job %d: %w", job.ID, err)
	}
	log.Warn().Err(cause).Int64("job_id", job.ID).Int("attempt", job.Attempts).
		Dur("retry_in", delay).Msg("job failed, retry scheduled")
	return nil
}

// FailPermanent marks a job as failed without another attempt.
func (q *PostgresQueue) FailPermanent(ctx context.Context, job *Job, cause error) error {
	_, err := q.db.ExecContext(ctx, `
		UPDATE jobs
		SET status = 'failed', locked_at = NULL, locked_by = NULL, last_error = $2, updated_at = now()
		WHERE id = $1`, job.ID, truncateError(cause))
	if err != nil {
		return fmt.Errorf("fail job %d: %w", job.ID, err)
	}
	log.Error().Err(cause).Int64("job_id", job.ID).Msg("job failed permanently")
	return nil
}

// RequeueExpired releases jobs whose worker died mid-run (locked_at older than
// the visibility timeout) so another worker can pick them up.
func (q *PostgresQueue) RequeueExpired(ctx context.Context) (int64, error) {
	res, err := q.db.ExecContext(ctx, `
		UPDATE jobs
		SET status = 'pending', locked_at = NULL, locked_by = NULL, updated_at = now()
		WHERE status = 'running' AND locked_at < now() - make_interval(secs => $1)`,
		q.opts.VisibilityTimeout.Seconds())
	if err != nil {
		return 0, fmt.Errorf("requeue expired jobs: %w", err)
	}
	return res.RowsAffected()
}

// Run starts `workers` concurrent consumers and blocks until ctx is cancelled.
// In-flight handlers get the cancelled context and the call returns once they
// finish, which gives graceful shutdown on SIGTERM.
func (q *PostgresQueue) Run(ctx context.Context, workers int, handlers map[string]Handler) error {
	if workers <= 0 {
		workers = 1
	}
	var wg sync.WaitGroup
	for i := range workers {
		wg.Add(1)
		go func(n int) {
			defer wg.Done()
			q.work(ctx, fmt.Sprintf("%s-%d", q.opts.LockID, n), handlers)
		}(i)
	}
	<-ctx.Done()
	wg.Wait()
	return ctx.Err()
}

func (q *PostgresQueue) work(ctx context.Context, lockID string, handlers map[string]Handler) {
	timer := time.NewTimer(0)
	defer timer.Stop()

	for {
		select {
		case <-ctx.Done():
			return
		case <-timer.C:
		}

		if n, err := q.RequeueExpired(ctx); err != nil {
			if ctx.Err() == nil {
				log.Error().Err(err).Msg("requeue expired jobs failed")
			}
		} else if n > 0 {
			log.Warn().Int64("jobs", n).Msg("requeued jobs from dead workers")
		}

		for ctx.Err() == nil {
			job, err := q.Claim(ctx, lockID)
			if err != nil {
				if ctx.Err() == nil {
					log.Error().Err(err).Msg("claim job failed")
				}
				break
			}
			if job == nil {
				break
			}
			q.handle(ctx, job, handlers)
		}

		timer.Reset(q.opts.PollInterval)
	}
}

func (q *PostgresQueue) handle(ctx context.Context, job *Job, handlers map[string]Handler) {
	handler, ok := handlers[job.Kind]
	if !ok {
		_ = q.FailPermanent(ctx, job, fmt.Errorf("no handler registered for kind %q", job.Kind))
		return
	}

	runCtx, cancel := context.WithTimeout(ctx, q.opts.VisibilityTimeout)
	err := handler(runCtx, job)
	cancel()

	if err != nil {
		if failErr := q.Retry(ctx, job, err); failErr != nil {
			log.Error().Err(failErr).Int64("job_id", job.ID).Msg("could not schedule retry; job will be requeued after visibility timeout")
		}
		return
	}
	if err := q.Complete(ctx, job.ID); err != nil {
		log.Error().Err(err).Int64("job_id", job.ID).Msg("could not mark job complete")
	}
}

func (q *PostgresQueue) retryDelay(attempt int) time.Duration {
	delay := q.opts.RetryBase
	for i := 1; i < attempt; i++ {
		delay *= 2
		if delay >= q.opts.RetryMax {
			return q.opts.RetryMax
		}
	}
	if delay > q.opts.RetryMax {
		return q.opts.RetryMax
	}
	return delay
}

// truncateError keeps last_error bounded so a huge stack trace cannot bloat the row.
func truncateError(err error) string {
	if err == nil {
		return ""
	}
	const max = 2000
	msg := err.Error()
	if len(msg) > max {
		return msg[:max]
	}
	return msg
}
